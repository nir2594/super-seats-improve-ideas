<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Improvement Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6; /* Tailwind gray-100 */
        }
        /* Custom scrollbar for better aesthetics */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; 
        }
        ::-webkit-scrollbar-thumb {
            background: #c1c1c1; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8; 
        }
    </style>
</head>
<body class="text-slate-800 antialiased h-screen flex overflow-hidden">

    <aside class="w-64 bg-white border-r border-slate-200 flex flex-col hidden md:flex">
        <div class="h-16 flex items-center px-6 border-b border-slate-200">
            <i data-lucide="trending-up" class="w-6 h-6 text-indigo-600 mr-2"></i>
            <span class="font-bold text-lg text-slate-900">BizTracker</span>
        </div>
        
        <nav class="flex-1 overflow-y-auto py-4">
            <ul class="space-y-1 px-3" id="nav-menu">
                <!-- Navigation items will be generated by JS -->
            </ul>
        </nav>

        <div class="p-4 border-t border-slate-200">
            <div class="mb-2 flex justify-between text-sm font-medium">
                <span>Overall Progress</span>
                <span id="overall-progress-text">0%</span>
            </div>
            <div class="w-full bg-slate-200 rounded-full h-2.5">
                <div id="overall-progress-bar" class="bg-indigo-600 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
            </div>
            <button onclick="resetProgress()" class="mt-4 w-full py-2 px-4 border border-slate-300 rounded-md text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                Reset Progress
            </button>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-full overflow-hidden relative">
        
        <!-- Mobile Header -->
        <header class="md:hidden h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 z-10">
            <div class="flex items-center">
                <i data-lucide="trending-up" class="w-6 h-6 text-indigo-600 mr-2"></i>
                <span class="font-bold text-lg text-slate-900">BizTracker</span>
            </div>
            <button id="mobile-menu-btn" class="p-2 text-slate-500 hover:bg-slate-100 rounded-md">
                <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
        </header>

        <!-- Mobile Menu (Hidden by default) -->
        <div id="mobile-menu" class="fixed inset-0 bg-slate-800 bg-opacity-50 z-40 hidden md:hidden">
            <div class="fixed inset-y-0 right-0 max-w-xs w-full bg-white shadow-xl flex flex-col translate-x-full transition-transform duration-300 ease-in-out" id="mobile-menu-panel">
                <div class="h-16 flex items-center justify-between px-4 border-b border-slate-200">
                    <span class="font-bold text-lg">Menu</span>
                    <button id="close-mobile-menu-btn" class="p-2 text-slate-500 hover:bg-slate-100 rounded-md">
                        <i data-lucide="x" class="w-6 h-6"></i>
                    </button>
                </div>
                <nav class="flex-1 overflow-y-auto py-4 px-3" id="mobile-nav-menu">
                    <!-- Mobile nav items -->
                </nav>
            </div>
        </div>

        <!-- Content Area -->
        <div class="flex-1 overflow-y-auto p-4 md:p-8" id="main-content">
            <div class="max-w-3xl mx-auto">
                <header class="mb-8">
                    <h1 class="text-3xl font-bold text-slate-900 mb-2" id="pillar-title">Select a Pillar</h1>
                    <p class="text-slate-500 text-lg" id="pillar-description">Choose a category from the sidebar to begin improving your business.</p>
                </header>

                <div id="tasks-container" class="space-y-4">
                    <!-- Tasks will be injected here -->
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 text-center text-slate-500">
                        <i data-lucide="check-circle" class="w-12 h-12 mx-auto mb-4 text-slate-300"></i>
                        <p>Select a pillar to view your execution checklist.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Business Improvement Guide Data
        const guideData = [
            {
                id: 'strategy',
                title: 'Strategy & Planning',
                icon: 'compass',
                description: 'The foundation. Before you can improve, you need to know exactly where you are and where you want to go.',
                tasks: [
                    { id: 'strat-1', text: 'Conduct a comprehensive SWOT Analysis (Strengths, Weaknesses, Opportunities, Threats).' },
                    { id: 'strat-2', text: 'Define 3-5 SMART goals (Specific, Measurable, Achievable, Relevant, Time-bound) for the next quarter.' },
                    { id: 'strat-3', text: 'Document and refine your core Value Proposition. Why should customers choose you?' },
                    { id: 'strat-4', text: 'Create a KPI Dashboard to track 5-7 critical business metrics weekly.' }
                ]
            },
            {
                id: 'customers',
                title: 'Customers & Marketing',
                icon: 'users',
                description: 'The growth engine. Improving how you attract and retain customers is critical for sustainable growth.',
                tasks: [
                    { id: 'cust-1', text: 'Conduct customer research (surveys, interviews) to map their pain points and desires.' },
                    { id: 'cust-2', text: 'Map out the complete customer journey and identify at least two friction points to fix.' },
                    { id: 'cust-3', text: 'Review marketing spend and calculate the ROI for each channel.' },
                    { id: 'cust-4', text: 'Implement one new strategy focused specifically on customer retention/loyalty.' }
                ]
            },
            {
                id: 'operations',
                title: 'Operations & Efficiency',
                icon: 'settings',
                description: 'The engine room. Efficiency is doing things right; effectiveness is doing the right things.',
                tasks: [
                    { id: 'ops-1', text: 'Map out your most critical business process and identify bottlenecks.' },
                    { id: 'ops-2', text: 'Identify and automate at least one repetitive, manual task.' },
                    { id: 'ops-3', text: 'Review inventory or resource management practices for potential savings.' },
                    { id: 'ops-4', text: 'Schedule a comprehensive monthly review of financial statements (Cash flow, Income, Balance).' }
                ]
            },
            {
                id: 'team',
                title: 'Team & Culture',
                icon: 'users-round',
                description: 'The fuel. Your people are your most valuable asset. A motivated team is essential.',
                tasks: [
                    { id: 'team-1', text: 'Identify one key training or development opportunity for your team.' },
                    { id: 'team-2', text: 'Implement a system for collecting anonymous employee feedback.' },
                    { id: 'team-3', text: 'Review compensation/incentives to ensure they align with your new SMART goals.' },
                    { id: 'team-4', text: 'Identify one task you currently handle that can be delegated to a team member.' }
                ]
            },
            {
                id: 'technology',
                title: 'Technology & Innovation',
                icon: 'laptop',
                description: 'The future. Staying competitive requires keeping up with tech and looking for better ways.',
                tasks: [
                    { id: 'tech-1', text: 'Audit your current software subscriptions and cancel unused tools.' },
                    { id: 'tech-2', text: 'Identify one area where data analytics could improve your decision-making.' },
                    { id: 'tech-3', text: 'Run a "safe to fail" experiment or pilot project this month.' },
                    { id: 'tech-4', text: 'Schedule a quarterly review of industry trends and competitor activities.' }
                ]
            }
        ];

        // State Management
        let currentPillarId = null;
        let taskProgress = JSON.parse(localStorage.getItem('bizTrackerProgress')) || {};

        // Calculate total tasks for progress bar
        const totalTasks = guideData.reduce((acc, pillar) => acc + pillar.tasks.length, 0);

        function init() {
            renderNavigation();
            updateOverallProgress();
            lucide.createIcons();
            
            // Mobile Menu Event Listeners
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const closeMobileMenuBtn = document.getElementById('close-mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileMenuPanel = document.getElementById('mobile-menu-panel');

            function openMobileMenu() {
                mobileMenu.classList.remove('hidden');
                setTimeout(() => {
                    mobileMenuPanel.classList.remove('translate-x-full');
                }, 10);
            }

            function closeMobileMenu() {
                mobileMenuPanel.classList.add('translate-x-full');
                setTimeout(() => {
                    mobileMenu.classList.add('hidden');
                }, 300);
            }

            mobileMenuBtn.addEventListener('click', openMobileMenu);
            closeMobileMenuBtn.addEventListener('click', closeMobileMenu);
            
            // Load first pillar by default if none selected
            if(guideData.length > 0) {
                 selectPillar(guideData[0].id);
            }
        }

        function renderNavigation() {
            const navMenu = document.getElementById('nav-menu');
            const mobileNavMenu = document.getElementById('mobile-nav-menu');
            let navHtml = '';

            guideData.forEach(pillar => {
                // Calculate progress for this specific pillar
                const completedInPillar = pillar.tasks.filter(t => taskProgress[t.id]).length;
                const totalInPillar = pillar.tasks.length;
                const isComplete = completedInPillar === totalInPillar && totalInPillar > 0;
                
                const activeClass = currentPillarId === pillar.id ? 'bg-indigo-50 text-indigo-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900';
                
                navHtml += `
                    <li>
                        <button onclick="selectPillar('${pillar.id}')" class="w-full flex items-center justify-between px-3 py-2.5 rounded-md text-sm font-medium transition-colors ${activeClass}">
                            <div class="flex items-center">
                                <i data-lucide="${pillar.icon}" class="w-5 h-5 mr-3 ${currentPillarId === pillar.id ? 'text-indigo-600' : 'text-slate-400'}"></i>
                                ${pillar.title}
                            </div>
                            ${isComplete ? `<i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-500"></i>` : 
                                           `<span class="text-xs text-slate-400">${completedInPillar}/${totalInPillar}</span>`}
                        </button>
                    </li>
                `;
            });

            navMenu.innerHTML = navHtml;
            mobileNavMenu.innerHTML = navHtml;
            
            // Re-initialize icons for newly added HTML
            lucide.createIcons();
        }

        function selectPillar(pillarId) {
            currentPillarId = pillarId;
            const pillar = guideData.find(p => p.id === pillarId);
            
            if (!pillar) return;

            // Update UI Header
            document.getElementById('pillar-title').textContent = pillar.title;
            document.getElementById('pillar-description').textContent = pillar.description;

            // Render Tasks
            const tasksContainer = document.getElementById('tasks-container');
            let tasksHtml = '';

            pillar.tasks.forEach(task => {
                const isCompleted = !!taskProgress[task.id];
                
                tasksHtml += `
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-5 flex items-start transition-all hover:shadow-md cursor-pointer" onclick="toggleTask('${task.id}')">
                        <div class="flex-shrink-0 mt-0.5">
                            <button class="w-6 h-6 rounded border flex items-center justify-center transition-colors ${isCompleted ? 'bg-indigo-600 border-indigo-600 text-white' : 'border-slate-300 text-transparent hover:border-indigo-400'}">
                                <i data-lucide="check" class="w-4 h-4 ${isCompleted ? 'opacity-100' : 'opacity-0'}"></i>
                            </button>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="text-base ${isCompleted ? 'text-slate-400 line-through' : 'text-slate-700'} transition-all">${task.text}</p>
                        </div>
                    </div>
                `;
            });

            tasksContainer.innerHTML = tasksHtml;
            
            // Update Navigation active state
            renderNavigation();
            
            // Re-initialize icons
            lucide.createIcons();

            // Close mobile menu if open
            const mobileMenuPanel = document.getElementById('mobile-menu-panel');
            if (!mobileMenuPanel.classList.contains('translate-x-full')) {
                document.getElementById('close-mobile-menu-btn').click();
            }
        }

        function toggleTask(taskId) {
            // Toggle boolean state
            taskProgress[taskId] = !taskProgress[taskId];
            
            // Save to LocalStorage
            localStorage.setItem('bizTrackerProgress', JSON.stringify(taskProgress));
            
            // Re-render current pillar tasks and overall progress
            selectPillar(currentPillarId);
            updateOverallProgress();
        }

        function updateOverallProgress() {
            const completedTasks = Object.values(taskProgress).filter(Boolean).length;
            const percentage = totalTasks === 0 ? 0 : Math.round((completedTasks / totalTasks) * 100);
            
            document.getElementById('overall-progress-text').textContent = `${percentage}%`;
            document.getElementById('overall-progress-bar').style.width = `${percentage}%`;
        }

        function resetProgress() {
            if(confirm("Are you sure you want to reset all your progress? This cannot be undone.")) {
                taskProgress = {};
                localStorage.removeItem('bizTrackerProgress');
                selectPillar(currentPillarId);
                updateOverallProgress();
            }
        }

        // Run initialization on load
        window.addEventListener('DOMContentLoaded', init);

    </script>
</body>
</html>
